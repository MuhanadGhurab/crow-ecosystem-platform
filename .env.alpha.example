# Crow Alpha Development — local env template (placeholders only)
#
# Copy to `.env.local` on EACH device. Never commit `.env.local`.
# Do not paste real secrets into docs, GitHub issues, or chat prompts.
#
# Runtime classification (CROW.DEVFLOW.2):
CROW_RUNTIME_MODE=alpha_development
CROW_DATA_CLASSIFICATION=demo_only

# Forbidden for Alpha Mode:
# - real customer data
# - payment secrets used for live charges
# - production-only secrets in local files shared across devices carelessly
# - CROW_ALLOW_REAL_CUSTOMER_DATA=true
# - CROW_ALLOW_DISCOVERY_BLUEPRINT_COMPLETE=1  (unless separately authorized)

# Optional local site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prefer disposable local Postgres for day-to-day work (see .env.local.example).
# If you point at the shared Supabase demo/dev sandbox, treat ALL data as demo/test only.
# DATABASE_URL=postgresql://crow:crow_local_dev@127.0.0.1:5433/crow_ecosystem?schema=public
# DIRECT_URL=postgresql://crow:crow_local_dev@127.0.0.1:5433/crow_ecosystem?schema=public

# Supabase Auth — placeholders only (replace per-device; never commit real keys)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEMO_OR_DEV_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-demo-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-demo-service-role-key

# Vercel env vars stay in the Vercel dashboard — do not duplicate Production secrets here.

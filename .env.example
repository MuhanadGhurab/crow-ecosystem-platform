# Crow Ecosystem — environment template
# Copy to .env and fill values. Never commit .env.
#
# Setup guides:
#   Option B (recommended): docs/HYBRID_LOCAL_DB_SUPABASE_AUTH.md
#   Local Postgres only:    docs/LOCAL_POSTGRES_SETUP.md
#   Prisma db push:           docs/PRISMA_DB_PUSH.md
#   UI-only (no login):       docs/BASELINE.md § AUTH_DISABLED

# ═══════════════════════════════════════════════════════════════════════════════
# Option B — RECOMMENDED HYBRID (local Postgres + Supabase Auth only)
# ═══════════════════════════════════════════════════════════════════════════════
# Organizational data → local crow_ecosystem | Login/sessions → Supabase project
# Do NOT point DATABASE_URL at Supabase when using this mode.

# ─── LOCAL DATABASE (Prisma) ─────────────────────────────────────────────────
# pgAdmin server: Crow Local | database: crow_ecosystem | port: 5432
# Push without editing .env (Windows): npm run db:push:local

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/crow_ecosystem?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/crow_ecosystem?schema=public"

# ─── SUPABASE AUTH ONLY (identity — not Prisma data) ─────────────────────────
# Dashboard: Project Settings → API
# Keep DATABASE_URL on localhost above; do not use Supabase pooler URLs for Prisma here.

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-only — bootstrap / grant-role scripts (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Real login in hybrid mode (use true only for UI-only demos — see BASELINE.md)
AUTH_DISABLED=false

# Optional: pipeline mock fallbacks when Prisma errors or for admin UI demos
# USE_MOCK_DATA=true

# Optional: auto-seed ERP sample data after provision (dev/staging only)
# TENANT_OPS_SEED=true

# Optional: Microsoft Entra / SSO (Option B — Supabase Azure provider, not direct MSAL)
# Secrets (CLIENT_SECRET) go in Supabase Dashboard only. See docs/ENTRA_SSO.md and
# archive/ms-identity-node-main/README-CYBERCROW.md for mapping from the MS sample.
#
 AZURE_SSO_ENABLED=true
 NEXT_PUBLIC_AZURE_TENANT_ID=your-directory-tenant-id   # sample TENANT_ID / Directory ID
# Application (client) ID → Supabase Azure provider (sample CLIENT_ID — not in .env)
# Azure redirect URI (register in Portal, not localhost):
#   https://[PROJECT_REF].supabase.co/auth/v1/callback
# Supabase allow list (app return URL):
#   http://localhost:3000/auth/callback
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════════
# Alternative — Supabase Postgres + Auth (single cloud project)
# ═══════════════════════════════════════════════════════════════════════════════
# Uncomment INSTEAD of the local DATABASE_URL block above (not together with Option B).
# Dashboard: Project Settings → Database → Connect
#
# DATABASE_URL — Transaction pooler (port 6543) for Next.js / Prisma Client at runtime
# DIRECT_URL   — Session pooler (port 5432) for prisma db push / migrate
#
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ═══════════════════════════════════════════════════════════════════════════════
# UI-only mode (no Postgres, no Supabase login)
# ═══════════════════════════════════════════════════════════════════════════════
# AUTH_DISABLED=true
# USE_MOCK_DATA=true
# See docs/BASELINE.md and docs/DEV_WITHOUT_DB.md

# ─── Notifications (deferred — not required for local / MEEM demo) ─────────────
# Pipeline events always log to platformNotification; /admin/audit shows them.
# Without RESEND_API_KEY, email status is "skipped" (expected in dev).
# Add when production-ready (Phase Cloud): docs/PHASES.md § Phase Cloud
#
# RESEND_API_KEY=re_...
# NOTIFICATION_FROM_EMAIL="Crow Ecosystem <noreply@yourdomain.com>"
# PLATFORM_NOTIFY_EMAIL=admin@yourcompany.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Stripe billing (Phase 8.4 — optional until live) ───────────────────────
# See docs/STRIPE_BILLING.md
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_STARTUP=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# ─── Go-live readiness gate (Phase 8) ─────────────────────────────────────────
# GO_LIVE_READINESS_GATE=true
# GO_LIVE_READINESS_STRICT=true

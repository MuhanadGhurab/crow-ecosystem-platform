# ═══════════════════════════════════════════════════════════════════════════════
#  Supabase Postgres + Auth (single cloud project)
# ═══════════════════════════════════════════════════════════════════════════════
# Uncomment INSTEAD of the local DATABASE_URL block above (not together with Option B).
# Dashboard: Project Settings → Database → Connect
#
# DATABASE_URL — Transaction pooler (port 6543) for Next.js / Prisma Client at runtime
# DIRECT_URL   — Session pooler (port 5432) for prisma db push / migrate
#
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ═══════════════════════════════════════════════════════════════════════════════
# UI-only mode (no Postgres, no Supabase login)
# ═══════════════════════════════════════════════════════════════════════════════
# AUTH_DISABLED=true
# USE_MOCK_DATA=true
# See docs/internal/BASELINE.md and docs/internal/DEV_WITHOUT_DB.md

# ═══════════════════════════════════════════════════════════════════════════════
# M7 — Vercel / production (see docs/internal/M7_CLOUD_DEPLOY.md)
# ═══════════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# AUTH_DISABLED must be false or unset in production (enforced at startup).
# USE_MOCK_DATA must be false in production smoke / go-live paths.

# ─── Notifications (M2–M3 platform finish — real send, not only "skipped") ─────
# Guide: docs/internal/RESEND_SETUP.md · test: npm run test:resend
#
# RESEND_API_KEY=re_...
# NOTIFICATION_FROM_EMAIL=Crow Ecosystem <onboarding@resend.dev>
# PIPELINE_NOTIFY_EMAIL_OVERRIDE=your-inbox@example.com
# PLATFORM_NOTIFY_EMAIL=ops@example.com
# NOTIFICATION_TEST_EMAIL=your-inbox@example.com

# ─── Stripe billing (Phase 8.4 — optional until live) ───────────────────────
# See docs/internal/STRIPE_BILLING.md
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_STARTUP=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# ─── Go-live readiness gate (Phase 8) ─────────────────────────────────────────
# GO_LIVE_READINESS_GATE=true
# GO_LIVE_READINESS_STRICT=true

# C3 local auth sandbox — copy to .env.local and adjust.
# Never point this file at Preview or Production Supabase/Postgres.

# --- Real local auth mode (final C3 validation) ---
AUTH_DISABLED=false
USE_MOCK_DATA=false
ACCOUNT_REGISTRATION_ENABLED=true
CROW_PHONE_VERIFICATION_REQUIRED=false
CROW_ONBOARDING_GENERATION_REQUIRED=2
LOCAL_EMAIL_PROVIDER=mailpit
LOCAL_AUTH_DIAGNOSTICS_ENABLED=true

# Disposable local Postgres (docker-compose.local.yml — host port 5433)
DATABASE_URL=postgresql://crow:crow_local_dev@127.0.0.1:5433/crow_ecosystem?schema=public
DIRECT_URL=postgresql://crow:crow_local_dev@127.0.0.1:5433/crow_ecosystem?schema=public

# Mailpit (SMTP 1025, inbox UI http://127.0.0.1:8025)
MAILPIT_API_URL=http://127.0.0.1:8025
MAILPIT_FROM_EMAIL=noreply@crow.local
MAILPIT_FROM_NAME=Crow

# Hosted Preview/Production uses Resend — not Mailpit (set on Vercel only)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# C3_VERIFICATION_FROM_EMAIL=Crow <verified-sender@your-domain>

# Supabase Auth — use a dedicated dev project, NOT production
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Visual preview mode (UI/screenshots only — NOT for auth approval) ---
# AUTH_DISABLED=true
# USE_MOCK_DATA=true
# LOCAL_EMAIL_PROVIDER=in-memory

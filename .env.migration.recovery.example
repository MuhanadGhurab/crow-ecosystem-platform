# CLOUD.1D — operator-attested migration recovery evidence (gitignored).
# Copy to .env.migration.recovery and fill after Dashboard verification.
# Never commit this file.

# Opaque non-secret reference (dashboard backup id, operator ticket, etc.)
MIGRATION_BACKUP_REFERENCE=

# ISO-8601 timestamp when backup/PITR was verified in Supabase Dashboard
MIGRATION_BACKUP_VERIFIED_AT=

# Exactly BACKUP or PITR
MIGRATION_RECOVERY_METHOD=BACKUP

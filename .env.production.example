# Crow Ecosystem — production / staging template (M7)
# NEVER commit real secrets here. Use .env.staging (gitignored) or Vercel env UI.
# Guide: docs/internal/P2_STAGING_PREP.md · Vercel: docs/internal/VERCEL_CONNECT.md

NODE_ENV=production

# Supabase Postgres — Dashboard → Database → Connect
# Password with @ must be URL-encoded (%40). Only DATABASE_URL uses ?pgbouncer=true
DATABASE_URL=postgresql://postgres.[POOLER_USER]:[PASSWORD_ENCODED]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[POOLER_USER]:[PASSWORD_ENCODED]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Auth (same project as DB)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # legacy anon key also works
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

AUTH_DISABLED=false
USE_MOCK_DATA=false

# AZURE_SSO_ENABLED=true
# NEXT_PUBLIC_AZURE_TENANT_ID=your-tenant-id
# TENANT_OPS_SEED=true

# M8 — optional (use sk_test_ / pk_test_ on staging)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# RESEND_API_KEY=re_...
# NOTIFICATION_FROM_EMAIL=Crow <onboarding@resend.dev>
# PIPELINE_NOTIFY_EMAIL_OVERRIDE=you@example.com

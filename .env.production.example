# Crow Ecosystem â€” production / staging template (M7)
# NEVER commit real secrets here. Use .env.staging (gitignored) or Vercel env UI.
# Guide: docs/internal/P2_STAGING_PREP.md Â· Vercel: docs/internal/VERCEL_CONNECT.md

NODE_ENV=production

# Supabase Postgres â€” Dashboard â†’ Database â†’ Connect
# Password with @ must be URL-encoded (%40). Only DATABASE_URL uses ?pgbouncer=true
DATABASE_URL=postgresql://postgres.[POOLER_USER]:[PASSWORD_ENCODED]@aws-[N]-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[POOLER_USER]:[PASSWORD_ENCODED]@aws-[N]-[REGION].pooler.supabase.com:5432/postgres

# Supabase Auth (same project as DB)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # legacy anon key also works
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

AUTH_DISABLED=false
USE_MOCK_DATA=false
ACCOUNT_REGISTRATION_ENABLED=false
# Production app + production database (aligned — required for C2 mutation guards off Vercel).
APP_ENVIRONMENT=production
DATABASE_ENVIRONMENT=production
# Vercel Preview on shared Supabase uses APP_ENVIRONMENT=preview + DATABASE_ENVIRONMENT=production
# + BACKEND_ISOLATION=shared — configure on the Preview branch in Vercel, not in this file.

# Crow Legal v1.1 publication (operator-only — not enabled by env presence alone)
# CROW_LEGAL_ENTITY_NAME=
# LEGAL_CONTACT_EMAIL=
# PRIVACY_CONTACT_EMAIL=
# DATA_RIGHTS_CONTACT_EMAIL=
# SECURITY_CONTACT_EMAIL=
# ABUSE_CONTACT_EMAIL=
# CROW_LEGAL_V1_1_PUBLICATION_AUTHORIZED=false
# ALLOW_HOSTED_LEGAL_PUBLICATION=false
# PRODUCTION_LEGAL_V11_CODE_COMPATIBLE=false

EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# C3_VERIFICATION_FROM_EMAIL=Crow <verified-sender@your-domain>
# EMAIL_VERIFICATION_CODE_SECRET=...
# EXPECTED_DATABASE_FINGERPRINT=...

# AZURE_SSO_ENABLED=true
# NEXT_PUBLIC_AZURE_TENANT_ID=your-tenant-id
# GOOGLE_SSO_ENABLED=true
# Google Client ID/Secret: Supabase Dashboard only (see docs/internal/F18_GOOGLE_SIGNIN_SETUP.md)
# TENANT_OPS_SEED=true

# M8 â€” optional (use sk_test_ / pk_test_ on staging)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# RESEND_API_KEY=re_...
# NOTIFICATION_FROM_EMAIL=Crow <onboarding@resend.dev>
# PIPELINE_NOTIFY_EMAIL_OVERRIDE=you@example.com


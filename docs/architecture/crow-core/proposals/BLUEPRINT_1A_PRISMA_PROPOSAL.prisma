model BlueprintReviewCycle {
  id                 String                    @id @default(cuid())
  blueprintId        String
  blueprintVersionId String
  versionNumber      Int
  cycleNumber        Int
  audience           BlueprintReviewAudience
  state              BlueprintReviewCycleState @default(OPEN)
  openedAt           DateTime                  @default(now())
  closedAt           DateTime?
  supersededByCycleId String?
  initiatedByPlatformAccountId String?

  blueprint        EnterpriseBlueprint        @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  blueprintVersion EnterpriseBlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Restrict)
  actions          BlueprintReviewAction[]

  @@unique([blueprintId, cycleNumber])
  @@unique([blueprintId, blueprintVersionId, audience, cycleNumber])
  @@index([blueprintId, versionNumber])
  @@map("blueprint_review_cycles")
}

model BlueprintReviewAction {
  id                       String   @id @default(cuid())
  reviewCycleId            String
  blueprintVersionId       String
  actorPlatformAccountId   String
  actorAuthorityClass      String
  action                   String
  reason                   String?
  contentHashAtAction      String
  createdAt                DateTime @default(now())

  reviewCycle      BlueprintReviewCycle       @relation(fields: [reviewCycleId], references: [id], onDelete: Restrict)
  blueprintVersion EnterpriseBlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Restrict)

  @@index([reviewCycleId, createdAt])
  @@index([blueprintVersionId])
  @@map("blueprint_review_actions")
}


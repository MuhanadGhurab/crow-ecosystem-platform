enum BlueprintRootLifecycleState {
  DRAFT_INTERNAL
  READY_FOR_INTERNAL_REVIEW
  CHANGES_REQUESTED_INTERNAL
  READY_TO_SHARE
  SHARED_WITH_CLIENT
  CLIENT_REVIEWING
  CLIENT_CHANGES_REQUESTED
  CLIENT_ACCEPTED
  PLATFORM_FINALIZED
  SUPERSEDED
  WITHDRAWN
}

enum BlueprintClientVisibilityState {
  NOT_SHARED
  SHARED_EXACT_VERSION
  CLIENT_REVIEW_CLOSED
}

enum BlueprintReviewAudience {
  INTERNAL
  CLIENT
}

enum BlueprintReviewCycleState {
  OPEN
  CHANGES_REQUESTED
  ACCEPTED
  CLOSED
  SUPERSEDED
}


// Crow Ecosystem Platform — unified schema (8 logical groups)
// Golden rule: Discovery understands. Blueprint defines. CEM runs. CyberCrow protects. SAREA adapts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── 1. Request tables ───────────────────────────────────────────────────────

enum ImplementationRequestStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_DISCOVERY
  BLUEPRINT_BUILD
  TENANT_PROVISIONING
  SECURITY_INIT
  SAREA_INIT
  GO_LIVE
  APPROVED
  REJECTED
  CANCELLED
}

model ImplementationRequest {
  id                  String                      @id @default(cuid())
  referenceCode       String                      @unique
  organizationName    String
  organizationNameAr  String?
  industry            String?
  employeeBand        String?
  countryCode         String                      @default("SA")
  status              ImplementationRequestStatus @default(PENDING_REVIEW)
  estimatedMonthlySar Decimal?                    @db.Decimal(12, 2)
  notes               String?
  /**
   * Supabase Auth user id when submitter signed in or linked via Entra email match
   */
  submittedByUserId   String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  contacts                       RequestContact[]
  requestedModules               RequestedModule[]
  requestedSecurityPkgs          RequestedSecurityPackage[]
  requestedPlans                 RequestedSubscriptionPlan[]
  discoveryProfile               DiscoveryProfile?
  enterpriseBlueprint            EnterpriseBlueprint?
  clientOrganizationRequestLinks ClientOrganizationRequestLink[]

  @@map("implementation_requests")
}

model RequestContact {
  id        String   @id @default(cuid())
  requestId String
  fullName  String
  email     String
  phone     String?
  jobTitle  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  request ImplementationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_contacts")
}

model RequestedModule {
  id        String @id @default(cuid())
  requestId String
  moduleKey String

  request ImplementationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, moduleKey])
  @@map("requested_modules")
}

model RequestedSecurityPackage {
  id         String @id @default(cuid())
  requestId  String
  packageKey String

  request ImplementationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, packageKey])
  @@map("requested_security_packages")
}

model RequestedSubscriptionPlan {
  id        String @id @default(cuid())
  requestId String
  planKey   String

  request ImplementationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("requested_subscription_plans")
}

// ─── 2. Discovery tables ───────────────────────────────────────────────────────

enum DiscoveryStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  APPROVED
}

model DiscoveryProfile {
  id          String          @id @default(cuid())
  requestId   String          @unique
  status      DiscoveryStatus @default(NOT_STARTED)
  summary     String?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  request                ImplementationRequest            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  answers                DiscoveryAnswer[]
  departments            DiscoveryDepartment[]
  branches               DiscoveryBranch[]
  roles                  DiscoveryRole[]
  workflows              DiscoveryWorkflow[]
  securityRequirements   DiscoverySecurityRequirement[]
  integrations           DiscoveryIntegration[]
  experienceRequirements DiscoveryExperienceRequirement[]
  enterpriseBlueprint    EnterpriseBlueprint?
  orgIntelligence        DiscoveryOrgIntelligence?

  @@map("discovery_profiles")
}

model DiscoveryAnswer {
  id          String @id @default(cuid())
  profileId   String
  sectionKey  String
  questionKey String
  valueJson   Json

  profile DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, sectionKey, questionKey])
  @@map("discovery_answers")
}

model DiscoveryDepartment {
  id        String  @id @default(cuid())
  profileId String
  name      String
  nameAr    String?
  headcount Int?

  profile DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("discovery_departments")
}

model DiscoveryBranch {
  id        String  @id @default(cuid())
  profileId String
  name      String
  city      String?
  region    String?

  profile DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("discovery_branches")
}

model DiscoveryRole {
  id        String  @id @default(cuid())
  profileId String
  name      String
  level     String?

  profile DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("discovery_roles")
}

model DiscoveryWorkflow {
  id          String  @id @default(cuid())
  profileId   String
  name        String
  description String?

  profile DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("discovery_workflows")
}

model DiscoverySecurityRequirement {
  id          String  @id @default(cuid())
  profileId   String
  requirement String
  priority    String?

  profile DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("discovery_security_requirements")
}

model DiscoveryIntegration {
  id          String  @id @default(cuid())
  profileId   String
  providerKey String
  notes       String?

  profile DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("discovery_integrations")
}

model DiscoveryExperienceRequirement {
  id          String @id @default(cuid())
  profileId   String
  personaKey  String
  requirement String

  profile DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("discovery_experience_requirements")
}

// ─── Organizational Intelligence (Phase D) ─────────────────────────────────────

enum OrgIntelligenceStatus {
  RECOMMENDED
  CUSTOMIZED
  ACCEPTED
}

/// Sector starting points — templates recommend; discovery/blueprint decide.
model SectorTemplate {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  industry      String?
  maturityLevel String?  @default("growth")
  isActive      Boolean  @default(true)
  configJson    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sector_templates")
}

/// Crow Intelligence recommendations for a discovery profile (advisory, editable).
model DiscoveryOrgIntelligence {
  id                  String                @id @default(cuid())
  profileId           String                @unique
  sectorTemplateKey   String
  status              OrgIntelligenceStatus @default(RECOMMENDED)
  recommendationsJson Json
  customizationsJson  Json?
  acceptedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  profile DiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([sectorTemplateKey])
  @@map("discovery_org_intelligence")
}

// ─── 3. Blueprint tables ───────────────────────────────────────────────────────

enum BlueprintStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum ProposalStatus {
  DRAFT
  SENT
  CLIENT_APPROVED
  DECLINED
}

model EnterpriseBlueprint {
  id                       String          @id @default(cuid())
  requestId                String          @unique
  discoveryProfileId       String          @unique
  /// C2 — explicit tenant ownership (nullable for legacy; backfill required)
  tenantId                 String?
  /// C2 — human-readable identity title
  title                    String?
  status                   BlueprintStatus @default(DRAFT)
  proposalStatus           ProposalStatus  @default(DRAFT)
  proposalToken            String?         @unique
  proposalSentAt           DateTime?
  clientApprovedAt         DateTime?
  /// Legacy monolithic version counter — superseded by EnterpriseBlueprintVersion
  version                  Int             @default(1)
  approvedAt               DateTime?
  /// C2 — pointers to versioned snapshots (enforced one-draft / one-approved via partial indexes)
  currentApprovedVersionId String?         @unique
  activeDraftVersionId     String?         @unique
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  request                 ImplementationRequest            @relation(fields: [requestId], references: [id])
  discoveryProfile        DiscoveryProfile                 @relation(fields: [discoveryProfileId], references: [id])
  tenantOwner             Tenant?                          @relation("BlueprintTenantOwner", fields: [tenantId], references: [id])
  modules                 BlueprintModule[]
  workflows               BlueprintWorkflow[]
  roles                   BlueprintRole[]
  permissions             BlueprintPermission[]
  securityBaselines       BlueprintSecurityBaseline[]
  sareaProfiles           BlueprintSareaProfile[]
  integrations            BlueprintIntegration[]
  goLiveChecklists        BlueprintGoLiveChecklist[]
  tenant                  Tenant?
  blueprintVersions       EnterpriseBlueprintVersion[]
  currentApprovedVersion  EnterpriseBlueprintVersion?      @relation("CurrentApprovedVersion", fields: [currentApprovedVersionId], references: [id], onDelete: Restrict)
  activeDraftVersion      EnterpriseBlueprintVersion?      @relation("ActiveDraftVersion", fields: [activeDraftVersionId], references: [id], onDelete: Restrict)
  blueprintApprovals      BlueprintApproval[]
  blueprintTraceEvents    BlueprintTraceEvent[]
  blueprintChangeRequests BlueprintChangeRequest[]
  configurationProposals  BlueprintConfigurationProposal[]
  roiAssumptions          RoiAssumption[]
  sowDocuments            SowDocument[]

  @@index([tenantId])
  @@map("enterprise_blueprints")
}

model BlueprintModule {
  id          String  @id @default(cuid())
  blueprintId String
  moduleKey   String
  enabled     Boolean @default(true)

  blueprint EnterpriseBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, moduleKey])
  @@map("blueprint_modules")
}

model BlueprintWorkflow {
  id          String @id @default(cuid())
  blueprintId String
  name        String
  configJson  Json?

  blueprint EnterpriseBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("blueprint_workflows")
}

model BlueprintRole {
  id          String @id @default(cuid())
  blueprintId String
  name        String
  slug        String

  blueprint   EnterpriseBlueprint   @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  permissions BlueprintPermission[]

  @@unique([blueprintId, slug])
  @@map("blueprint_roles")
}

model BlueprintPermission {
  id              String  @id @default(cuid())
  blueprintId     String
  blueprintRoleId String?
  permissionKey   String

  blueprint     EnterpriseBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  blueprintRole BlueprintRole?      @relation(fields: [blueprintRoleId], references: [id])

  @@map("blueprint_permissions")
}

model BlueprintSecurityBaseline {
  id          String @id @default(cuid())
  blueprintId String
  controlKey  String
  configJson  Json?

  blueprint EnterpriseBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("blueprint_security_baselines")
}

model BlueprintSareaProfile {
  id          String @id @default(cuid())
  blueprintId String
  personaKey  String
  configJson  Json?

  blueprint EnterpriseBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("blueprint_sarea_profiles")
}

model BlueprintIntegration {
  id          String @id @default(cuid())
  blueprintId String
  providerKey String
  configJson  Json?

  blueprint EnterpriseBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("blueprint_integrations")
}

model BlueprintGoLiveChecklist {
  id          String  @id @default(cuid())
  blueprintId String
  itemKey     String
  completed   Boolean @default(false)

  blueprint EnterpriseBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, itemKey])
  @@map("blueprint_go_live_checklists")
}

// ─── 3b. C2 Blueprint versioning & traceability ───────────────────────────────

enum BlueprintVersionStatus {
  DISCOVERY_DRAFT
  BLUEPRINT_DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  CHANGES_REQUESTED
  APPROVAL_PENDING
  APPROVED
  CONFIGURATION_PROPOSED
  SUPERSEDED
  ARCHIVED
}

enum BlueprintVersionProvenance {
  LEGACY_IMPORT
  STUDIO_CAPTURE
  NEXT_VERSION
  BACKFILL
  UNKNOWN
}

enum BlueprintTraceActorType {
  HUMAN
  AI_ASSISTANT
  AUTOMATION
  SERVICE_ACCOUNT
  INTEGRATION
  SYSTEM_PROCESS
}

enum BlueprintApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum BlueprintChangeRequestScope {
  CLIENT
  INTERNAL
}

enum BlueprintChangeRequestStatus {
  OPEN
  RESOLVED
  WITHDRAWN
}

enum BlueprintConfigurationProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum RoiAssumptionApprovalState {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RoiSourceType {
  OPERATOR_ESTIMATE
  BENCHMARK
  CLIENT_INPUT
  DISCOVERY
  SYSTEM_DEFAULT
}

enum SowVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum SowSectionProvenance {
  GENERATED
  MANUAL
  GENERATED_EDITED
  LOCKED
}

model EnterpriseBlueprintVersion {
  id                String                     @id @default(cuid())
  tenantId          String
  blueprintId       String
  versionNumber     Int
  parentVersionId   String?
  status            BlueprintVersionStatus     @default(BLUEPRINT_DRAFT)
  schemaVersion     String                     @default("1.0.0")
  contentSnapshot   Json
  contentHash       String
  revision          Int                        @default(1)
  isActiveDraft     Boolean                    @default(false)
  isCurrentApproved Boolean                    @default(false)
  provenance        BlueprintVersionProvenance @default(STUDIO_CAPTURE)
  authorUserId      String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  submittedAt       DateTime?
  reviewedAt        DateTime?
  approvedAt        DateTime?
  supersededAt      DateTime?
  archivedAt        DateTime?

  tenant                  Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  blueprint               EnterpriseBlueprint              @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  parentVersion           EnterpriseBlueprintVersion?      @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: Restrict)
  childVersions           EnterpriseBlueprintVersion[]     @relation("VersionLineage")
  approvals               BlueprintApproval[]
  traceEvents             BlueprintTraceEvent[]
  changeRequests          BlueprintChangeRequest[]
  configurationProposals  BlueprintConfigurationProposal[]
  roiSnapshots            RoiSnapshot[]
  sowVersions             SowVersion[]
  currentForBlueprint     EnterpriseBlueprint?             @relation("CurrentApprovedVersion")
  activeDraftForBlueprint EnterpriseBlueprint?             @relation("ActiveDraftVersion")

  @@unique([blueprintId, versionNumber])
  @@index([tenantId, blueprintId, createdAt(sort: Desc)])
  @@index([blueprintId, status])
  @@map("enterprise_blueprint_versions")
}

model BlueprintApproval {
  id                    String                    @id @default(cuid())
  tenantId              String
  blueprintId           String
  blueprintVersionId    String
  contentHash           String
  decision              BlueprintApprovalDecision
  approverUserId        String
  approverRole          String
  rationale             String?
  policyReference       String?
  evidenceRefs          Json?
  aiAssistanceDisclosed Boolean                   @default(false)
  externalSignatureRef  String?
  createdAt             DateTime                  @default(now())

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  blueprint        EnterpriseBlueprint        @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  blueprintVersion EnterpriseBlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Restrict)

  @@index([tenantId, blueprintId, createdAt(sort: Desc)])
  @@index([blueprintVersionId])
  @@map("blueprint_approvals")
}

model BlueprintTraceEvent {
  id                 String                  @id @default(cuid())
  tenantId           String
  blueprintId        String
  blueprintVersionId String?
  resourceType       String
  resourceId         String?
  actorType          BlueprintTraceActorType
  actorId            String?
  action             String
  reason             String?
  previousState      String?
  newState           String?
  impact             String?
  evidenceRefs       Json?
  aiInvolved         Boolean                 @default(false)
  correlationId      String?
  requestId          String?
  metadata           Json?
  createdAt          DateTime                @default(now())

  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  blueprint        EnterpriseBlueprint         @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  blueprintVersion EnterpriseBlueprintVersion? @relation(fields: [blueprintVersionId], references: [id], onDelete: Restrict)

  @@index([tenantId, blueprintId, createdAt(sort: Desc)])
  @@index([blueprintVersionId, createdAt])
  @@map("blueprint_trace_events")
}

model BlueprintChangeRequest {
  id                 String                       @id @default(cuid())
  tenantId           String
  blueprintId        String
  blueprintVersionId String
  requestedByUserId  String
  scope              BlueprintChangeRequestScope
  comments           Json
  status             BlueprintChangeRequestStatus @default(OPEN)
  createdAt          DateTime                     @default(now())
  resolvedAt         DateTime?

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  blueprint        EnterpriseBlueprint        @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  blueprintVersion EnterpriseBlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Restrict)

  @@index([tenantId, blueprintId])
  @@map("blueprint_change_requests")
}

model BlueprintConfigurationProposal {
  id                 String                               @id @default(cuid())
  tenantId           String
  blueprintId        String
  blueprintVersionId String
  targetTenantId     String
  requestedScope     Json
  status             BlueprintConfigurationProposalStatus @default(DRAFT)
  proposerUserId     String
  reviewerUserId     String?
  riskRefs           Json?
  evidenceRefs       Json?
  createdAt          DateTime                             @default(now())
  updatedAt          DateTime                             @updatedAt

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  blueprint        EnterpriseBlueprint        @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  blueprintVersion EnterpriseBlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Restrict)
  targetTenant     Tenant                     @relation("ConfigurationProposalTarget", fields: [targetTenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, blueprintId])
  @@map("blueprint_configuration_proposals")
}

model RoiAssumption {
  id          String   @id @default(cuid())
  tenantId    String
  blueprintId String
  key         String
  label       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  blueprint EnterpriseBlueprint     @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  revisions RoiAssumptionRevision[]

  @@unique([blueprintId, key])
  @@index([tenantId, blueprintId])
  @@map("roi_assumptions")
}

model RoiAssumptionRevision {
  id              String                     @id @default(cuid())
  tenantId        String
  assumptionId    String
  revisionNumber  Int
  value           Float
  unit            String
  currency        String                     @default("SAR")
  frequency       String?
  annualizedValue Float?
  source          String?
  sourceType      RoiSourceType              @default(OPERATOR_ESTIMATE)
  confidence      String?
  ownerUserId     String?
  approvalState   RoiAssumptionApprovalState @default(DRAFT)
  scenarioTags    String[]
  reviewedAt      DateTime?
  createdAt       DateTime                   @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assumption RoiAssumption @relation(fields: [assumptionId], references: [id], onDelete: Restrict)

  @@unique([assumptionId, revisionNumber])
  @@index([tenantId, assumptionId])
  @@map("roi_assumption_revisions")
}

model RoiSnapshot {
  id                    String   @id @default(cuid())
  tenantId              String
  blueprintVersionId    String
  assumptionRevisionIds String[]
  engineName            String
  engineVersion         String
  formulaVersion        String
  scenarioInputs        Json
  results               Json
  warnings              Json?
  unsupportedInputs     Json?
  currency              String   @default("SAR")
  advisoryLabel         String   @default("advisory_only")
  contentHash           String
  createdAt             DateTime @default(now())

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  blueprintVersion EnterpriseBlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Restrict)
  sowVersions      SowVersion[]

  @@index([blueprintVersionId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("roi_snapshots")
}

model SowDocument {
  id                   String   @id @default(cuid())
  tenantId             String
  blueprintId          String
  title                String
  commercialPackageRef String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  blueprint EnterpriseBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  versions  SowVersion[]

  @@index([tenantId, blueprintId])
  @@map("sow_documents")
}

model SowVersion {
  id                 String           @id @default(cuid())
  tenantId           String
  sowDocumentId      String
  versionNumber      Int
  status             SowVersionStatus @default(DRAFT)
  blueprintVersionId String
  roiSnapshotId      String?
  contentHash        String
  revision           Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  approvedAt         DateTime?

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sowDocument      SowDocument                @relation(fields: [sowDocumentId], references: [id], onDelete: Restrict)
  blueprintVersion EnterpriseBlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Restrict)
  roiSnapshot      RoiSnapshot?               @relation(fields: [roiSnapshotId], references: [id], onDelete: Restrict)
  sections         SowSection[]

  @@unique([sowDocumentId, versionNumber])
  @@index([tenantId, sowDocumentId])
  @@map("sow_versions")
}

model SowSection {
  id               String               @id @default(cuid())
  tenantId         String
  sowVersionId     String
  sectionKey       String
  orderIndex       Int
  title            String
  provenance       SowSectionProvenance @default(GENERATED)
  generatedContent String?
  manualContent    String?
  sourceRefs       Json?
  manuallyEdited   Boolean              @default(false)
  locked           Boolean              @default(false)
  completeness     String?
  warnings         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sowVersion SowVersion @relation(fields: [sowVersionId], references: [id], onDelete: Restrict)

  @@unique([sowVersionId, sectionKey])
  @@index([tenantId, sowVersionId, orderIndex])
  @@map("sow_sections")
}

// ─── 4. Tenant / CEM tables ──────────────────────────────────────────────────

model Organization {
  id            String   @id @default(cuid())
  legalName     String
  displayName   String
  displayNameAr String?
  vatNumber     String?
  industry      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenants Tenant[]

  @@map("organizations")
}

model Tenant {
  id             String   @id @default(cuid())
  slug           String   @unique
  organizationId String
  blueprintId    String?  @unique
  planKey        String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization                 Organization                     @relation(fields: [organizationId], references: [id])
  blueprint                    EnterpriseBlueprint?             @relation(fields: [blueprintId], references: [id])
  ownedBlueprints              EnterpriseBlueprint[]            @relation("BlueprintTenantOwner")
  blueprintVersions            EnterpriseBlueprintVersion[]
  blueprintApprovals           BlueprintApproval[]
  blueprintTraceEvents         BlueprintTraceEvent[]
  blueprintChangeRequests      BlueprintChangeRequest[]
  configurationProposals       BlueprintConfigurationProposal[]
  configurationProposalTargets BlueprintConfigurationProposal[] @relation("ConfigurationProposalTarget")
  roiAssumptions               RoiAssumption[]
  roiAssumptionRevisions       RoiAssumptionRevision[]
  roiSnapshots                 RoiSnapshot[]
  sowDocuments                 SowDocument[]
  sowVersions                  SowVersion[]
  sowSections                  SowSection[]
  modules                      OrganizationModule[]
  departments                  Department[]
  branches                     Branch[]
  profiles                     Profile[]
  roles                        Role[]
  workflows                    Workflow[]
  tasks                        Task[]
  approvals                    Approval[]
  documents                    Document[]
  reports                      Report[]
  subscription                 TenantSubscription?
  cybercrowAuditLogs           CybercrowAuditLog[]
  securityEvents               SecurityEvent[]
  riskScores                   RiskScore[]
  incidents                    Incident[]
  sareaProfiles                SareaExperienceProfile[]
  memberships                  TenantMembership[]
  membershipInvites            TenantMembershipInvite[]
  hrEmployees                  HrEmployee[]

{
  "name": "@ghv-val-1b/workspace",
  "private": true,
  "version": "0.0.0-validation",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test packages/testing/tests/workspace.test.mjs",
    "validate": "npm run typecheck && npm run test",
    "clean": "node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}

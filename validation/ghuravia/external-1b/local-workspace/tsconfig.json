{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@ghv-val-1b/contracts": ["./packages/contracts/src/index.ts"],
      "@ghv-val-1b/domain": ["./packages/domain/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts"]
}
